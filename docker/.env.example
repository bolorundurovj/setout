# Docker Compose Environment Configuration
# Copy this file to .env in your docker directory (or stack directory):
#   cp docker/.env.example docker/.env

# ------------------------------------------------------------------------------
# Setout Application
# ------------------------------------------------------------------------------
# Image tag to run (e.g. latest, edge, or a pinned version like 2.4.0)
SETOUT_IMAGE_TAG=latest

# Host port the app is published on
SETOUT_PORT=8474

# Session signing key (REQUIRED in production: set a long random string!)
SETOUT_SECRET_KEY=change-me

# Database connection URL for the API
SETOUT_DATABASE_URL=postgres://setout:setout@db:5432/setout

# Storage configuration (RustFS S3)
SETOUT_STORAGE_BACKEND=s3
SETOUT_S3_ENDPOINT_URL=http://s3:9000
SETOUT_S3_PUBLIC_URL=http://localhost:9000
SETOUT_S3_BUCKET=setout
SETOUT_S3_REGION=us-east-1
SETOUT_S3_ACCESS_KEY_ID=setout
SETOUT_S3_SECRET_ACCESS_KEY=setout-secret
SETOUT_S3_USE_PATH_STYLE=true
SETOUT_S3_AUTO_CREATE_BUCKET=true

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_USER=setout
POSTGRES_PASSWORD=setout
POSTGRES_DB=setout

# Host port for Postgres (defaults to 5433 to avoid clashing with host Postgres on 5432)
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# RustFS Object Storage
# ------------------------------------------------------------------------------
RUSTFS_IMAGE_TAG=latest
RUSTFS_ACCESS_KEY=setout
RUSTFS_SECRET_KEY=setout-secret
RUSTFS_ADDRESS=:9000
RUSTFS_CONSOLE_ADDRESS=:9001
RUSTFS_CONSOLE_ENABLE=true

# Published host ports for RustFS S3 API and web console
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# Legacy MinIO Migration (Only needed when migrating an existing MinIO installation)
# ------------------------------------------------------------------------------
# SETOUT_LEGACY_S3_ENDPOINT_URL=http://minio:9000
# SETOUT_LEGACY_S3_ACCESS_KEY_ID=setout
# SETOUT_LEGACY_S3_SECRET_ACCESS_KEY=setout-secret
# MINIO_ROOT_USER=setout
# MINIO_ROOT_PASSWORD=setout-secret
# MINIO_BUCKET=setout
