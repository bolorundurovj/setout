{
  "name": "@setout/api-client",
  "version": "1.3.0",
  "private": true,
  "description": "Generated TypeScript SDK for the Setout API. Do not edit src by hand; run make sdk.",
  "author": "Bolorunduro Valiant-Joshua (https://github.com/bolorundurovj)",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/bolorundurovj/setout",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bolorundurovj/setout.git",
    "directory": "packages/api-client"
  },
  "bugs": {
    "url": "https://github.com/bolorundurovj/setout/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "ng-openapi-gen --config ng-openapi-gen.json",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "ng-openapi-gen": "1.0.5",
    "prettier": "3.9.6"
  }
}
