# Setout configuration. Copy to .env and adjust.
# Every backend variable uses the SETOUT_ prefix.

# Port the API listens on.
SETOUT_PORT=8474

# Where the database and uploaded files live.
# Local development defaults to ./data if this is unset.
SETOUT_DATA_DIR=./data

# Database URL. SQLite by default, Postgres optional.
# SQLite:   sqlite://./data/setout.sqlite3
# Postgres: postgres://setout:setout@localhost:5433/setout
SETOUT_DATABASE_URL=sqlite://./data/setout.sqlite3

# Secret used to sign sessions. Set a long random value in production.
SETOUT_SECRET_KEY=change-me

# Log level: debug, info, warning, error.
SETOUT_LOG_LEVEL=info

# Origins allowed to call the API, comma separated. The single container serves
# the web app from the same origin, so this only matters when they are split.
SETOUT_CORS_ORIGINS=http://localhost:4200

# Send the session cookie only over HTTPS. Turn this on when Setout is
# reachable over anything other than localhost.
SETOUT_COOKIE_SECURE=false

# Where attached files live: local for the disk under SETOUT_DATA_DIR, or s3
# for any S3 compatible bucket. Amazon, MinIO, Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces and Hetzner all speak the same API.
SETOUT_STORAGE_BACKEND=local

# Only read when the backend is s3. Leave the endpoint unset for Amazon.
# SETOUT_S3_BUCKET=setout
# SETOUT_S3_ENDPOINT_URL=https://minio.example.com
# SETOUT_S3_REGION=us-east-1
# SETOUT_S3_ACCESS_KEY_ID=
# SETOUT_S3_SECRET_ACCESS_KEY=
# A folder inside the bucket, so one bucket can hold more than Setout.
# SETOUT_S3_PREFIX=attachments
# MinIO and some others want the bucket in the path rather than the host.
# SETOUT_S3_USE_PATH_STYLE=false
# Against the MinIO in docker/docker-compose.yml:
#   SETOUT_S3_ENDPOINT_URL=http://localhost:9000
#   SETOUT_S3_ACCESS_KEY_ID=setout
#   SETOUT_S3_SECRET_ACCESS_KEY=setout-secret
#   SETOUT_S3_USE_PATH_STYLE=true
# How long a link straight to the bucket stays good for.
# SETOUT_S3_LINK_SECONDS=300

# The largest file that can be attached, in bytes. 25 MB by default.
SETOUT_MAX_ATTACHMENT_BYTES=26214400

# Tiles for the map on a plot of land. The default is OpenStreetMap's own
# server. Point this at your own if you run Setout for more than a household:
# https://operations.osmfoundation.org/policies/tiles/
SETOUT_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
SETOUT_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Frontend API base URL. Relative by default so the single container works
# with no configuration.
API_BASE_URL=/api
